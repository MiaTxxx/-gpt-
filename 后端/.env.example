# 复制为 .env 后修改实际值。.env 文件不会被提交到 git。

# ===== 数据库 =====
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ===== JWT =====
# 生产环境务必换成至少 32 位随机字符串
SECRET_KEY=please-change-me-to-a-random-32-chars-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== Google OAuth（可选）=====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== GitHub OAuth =====
# 在 https://github.com/settings/developers 创建 OAuth App
# Authorization callback URL 必须与 GITHUB_REDIRECT_URI 完全一致
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8088/api/auth/github/callback

# ===== 前端地址（OAuth 回调后跳转） =====
FRONTEND_URL=http://localhost:5173

# ===== Email / SMTP（注册验证码） =====
# 是否要求注册时邮箱验证码（开发阶段可设为 false）
REQUIRE_EMAIL_VERIFICATION=true

# 推荐 Resend：smtp.resend.com:465  user=resend  password=API Key
# 腾讯企业邮箱:    smtp.exmail.qq.com:465 (SSL)
# 阿里云邮箱:      smtp.mxhichina.com:465 (SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Txxx的公益站
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173"]

# ===== ChatGPT 账号池 / 生图 =====
CHATGPT_BACKEND_BASE_URL=https://chat.openai.com
# 出向代理：留空 fallback 到注册机配置里的 proxy
CHATGPT_PROXY=
IMAGE_GENERATION_TIMEOUT=60
MAX_GENERATION_RETRIES=2
POOL_MAX_INFLIGHT_PER_ACCOUNT=1
REGISTER_PLAYWRIGHT_HEADLESS=true
